---
import '../styles/global.css'
import data from '../data/releases.json'

const { title = 'MyDegreePlan', description = 'A private degree planner that runs entirely on your own computer.' } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const repo = data.repo
// Social previews need absolute URLs; Astro.site comes from SITE_URL (set by the Pages workflow).
const abs = (path) => new URL(`${base}${path}`, Astro.site).href
const canonical = new URL(Astro.url.pathname, Astro.site).href
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MyDegreePlan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MyDegreePlan: map your whole degree and keep your data to yourself." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>MyDegreePlan</a>
        <nav aria-label="Main">
          <a href={`${base}/#features`}>Features</a>
          <a href={`${base}/#privacy`}>Privacy</a>
          <a href={`${base}/#get-started`}>Get started</a>
          <a href={`${base}/#download`}>Download</a>
          <a href={`${base}/changelog`}>Changelog</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site">
      <div class="wrap">
        <p>MyDegreePlan is a prototype degree planner and does not replace your academic advisor. <a href={`https://github.com/${repo}`}>Releases on GitHub</a>.</p>
      </div>
    </footer>
  </body>
</html>
