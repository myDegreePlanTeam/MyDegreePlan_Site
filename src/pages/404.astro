---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<Base title="Page not found · MyDegreePlan">
  <section>
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page doesn't exist.</h1>
      <p class="lede">It may have moved. The download and everything else is on the home page.</p>
      <div class="actions"><a class="btn" href={`${base}/`}>Back to MyDegreePlan</a></div>
    </div>
  </section>
</Base>
