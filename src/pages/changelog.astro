---
import Base from '../layouts/Base.astro'
import data from '../data/releases.json'
import { humanSize } from '../lib/releases.js'

const fmt = (iso) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
---
<Base title="Changelog · MyDegreePlan" description="Every MyDegreePlan release and what changed.">
  <section>
    <div class="wrap">
      <h1>Changelog</h1>
      {data.releases.length === 0 && <p class="lede">No releases yet.</p>}
      {data.releases.map((r) => (
        <details open={r === data.releases[0]}>
          <summary>v{r.version} · {fmt(r.publishedAt)}{r.required ? ' · required' : ''}</summary>
          {r.notes && <p class="notes">{r.notes}</p>}
          <p><a href={r.zip.url}>Download MyDegreePlan-{r.version}.zip</a> ({humanSize(r.zip.size)})</p>
        </details>
      ))}
    </div>
  </section>
</Base>
